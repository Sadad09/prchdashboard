rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    // Owner: always admin. Keep in sync with `admin` in firebase-config.js
    function isOwner() { return signedIn() && email() == 'sadadrasyad2@gmail.com'; }
    function memberPath() { return /databases/$(database)/documents/members/$(email()); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function isAdmin() { return isOwner() || (isMember() && get(memberPath()).data.role == 'admin'); }

    // Tracker data: tasks, pipeline, MoM, meetings, collaterals, team list, activity
    match /data/prch/{col}/{id} {
      allow read, write: if isOwner() || isMember();
    }

    // Who has access, and their role (admin / team / partner)
    match /members/{em} {
      allow read: if isAdmin() || (signedIn() && em == email());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && em == email()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'agency']));
    }

    // Access requests from people who signed in without access
    match /requests/{em} {
      allow read, delete: if isAdmin() || (signedIn() && em == email());
      allow create: if signedIn() && em == email()
        && request.resource.data.keys().hasOnly(['email', 'name', 'agency', 'role', 'at'])
        && request.resource.data.role in ['team', 'partner'];
    }
  }
}
